{
  "name": "duoscribe",
  "version": "1.3.0",
  "description": "Lightweight markdown viewer/editor with side-by-side raw and rendered panes",
  "main": "main.js",
  "author": "Ayush Abhijeet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushabhijeet/duoscribe.git"
  },
  "homepage": "https://github.com/ayushabhijeet/duoscribe",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "eval": "node scripts/eval-app.js"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "mermaid": "^11.16.1",
    "ws": "^8.21.2"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "build": {
    "appId": "com.duoscribe.app",
    "productName": "Duoscribe",
    "icon": "build/icon",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "vendor/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-mac-${arch}.${ext}"
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-win-setup.${ext}"
    }
  }
}
